{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kidney reference record v1.0",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "condition",
    "applies_to",
    "topic",
    "title",
    "text",
    "caution",
    "source_ids",
    "source_citations",
    "raw_refs",
    "raw_provenance",
    "origin",
    "evidence_kind",
    "population",
    "urgency",
    "index_eligible",
    "embedding_text",
    "clinical_review_status",
    "patient_care_approved",
    "use_scope",
    "prepared_on",
    "example_questions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(ST|CY|TU|NO|SH)[0-9]{3}$"
    },
    "schema_version": {
      "const": "1.0"
    },
    "condition": {
      "enum": [
        "stone",
        "cyst",
        "tumor",
        "normal",
        "shared"
      ]
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "stone",
          "cyst",
          "tumor",
          "normal"
        ]
      }
    },
    "topic": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "caution": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "source_citations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "raw_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "raw_provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "origin": {
      "type": "string"
    },
    "evidence_kind": {
      "type": "string"
    },
    "population": {
      "type": "string"
    },
    "subtype": {
      "type": [
        "string",
        "null"
      ]
    },
    "urgency": {
      "enum": [
        "informational",
        "prompt_assessment",
        "prompt_specialist_review",
        "urgent_now",
        "emergency_now"
      ]
    },
    "index_eligible": {
      "type": "boolean"
    },
    "embedding_text": {
      "type": "string",
      "minLength": 1
    },
    "clinical_review_status": {
      "const": "not_clinician_reviewed"
    },
    "patient_care_approved": {
      "const": false
    },
    "use_scope": {
      "const": "research_educational_prototype"
    },
    "prepared_on": {
      "type": "string",
      "format": "date"
    },
    "example_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "description": "Metadata and reference text for educational research. The separate validator checks selected constraints; it is not a full JSON Schema engine or clinical validator."
}
